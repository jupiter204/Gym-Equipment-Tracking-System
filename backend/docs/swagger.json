                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "private"
                ],
                "summary": "修改使用者資料",
                "parameters": [
                    {
                        "description": "修改使用者請求",
                        "name": "request",
