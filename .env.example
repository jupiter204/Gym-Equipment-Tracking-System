# Database configuration (in production, DB_PASSWORD must be >= 8 chars, not 'postgres', and not contain 'change_this')
DB_HOST=db
DB_USER=postgres
DB_PASSWORD=change_this_to_a_secure_password
DB_NAME=equipment_db

# Application configuration
PORT=8080
HTTP_PORT=8000
# JWT Secret MUST be at least 32 characters long
JWT_SECRET=please_generate_and_change_to_a_secure_jwt_secret_with_at_least_32_bytes!

# Timezone
TZ=Asia/Taipei
PGTZ=Asia/Taipei

# Production initial admin bootstrap (set on first boot, change password and remove afterwards)
# BOOTSTRAP_ADMIN_USERNAME=<管理員帳號>
# BOOTSTRAP_ADMIN_PASSWORD=<至少 8 字元的強密碼>

